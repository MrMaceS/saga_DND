# Скопируйте в .env и впишите ключ. Без ключа игра работает в офлайн-режиме (локальный интерпретатор и шаблонный диктор).
GEMINI_API_KEY=
# Актуальные стабильные модели. gemini-2.0-flash и gemini-1.5-pro выведены из эксплуатации.
MODEL_INTERPRETER=gemini-2.5-flash
MODEL_NARRATOR=gemini-2.5-pro
AI_TIMEOUT_S=20
HOST=0.0.0.0
PORT=8000
DEV=0
DICE_SEED=
# В Docker база лежит в смонтированной папке ./db
DATABASE_URL=sqlite+aiosqlite:///./data/saga.db
