{
  "cs_prologue": {
    "id": "cs_prologue",
    "title": "Пролог",
    "subtitles": [
      {
        "time": 0.0,
        "text": "Давно, когда фьорд Хладмарк ещё был богат, над ним поднялся туман, который не рассеивался три зимы."
      },
      {
        "time": 7.4,
        "text": "Люди начали исчезать."
      },
      {
        "time": 9.9,
        "text": "Лодки возвращались пустыми."
      },
      {
        "time": 12.4,
        "text": "Вы последние, кто остался."
      },
      {
        "time": 14.9,
        "text": "И этой ночью море принесло к вашему пирсу корабль."
      }
    ],
    "duration": 18.7,
    "audio": "audio/cutscenes/cs_prologue.mp3"
  },
  "cs_ship_arrives": {
    "id": "cs_ship_arrives",
    "title": "Корабль у пирса",
    "subtitles": [
      {
        "time": 0.0,
        "text": "Ночь опустилась на Хладмарк."
      },
      {
        "time": 2.5,
        "text": "У покосившегося пирса стоит драккар, целый, но без единого живого на палубе."
      },
      {
        "time": 8.2,
        "text": "Его паруса мокры, хотя дождя не было."
      },
      {
        "time": 11.0,
        "text": "В трюме что-то ударяет в доски."
      },
      {
        "time": 13.5,
        "text": "Раз."
      },
      {
        "time": 16.0,
        "text": "Пауза."
      },
      {
        "time": 18.5,
        "text": "Ещё раз."
      }
    ],
    "duration": 21.0,
    "audio": "audio/cutscenes/cs_ship_arrives.mp3"
  },
  "cs_shadows_pier": {
    "id": "cs_shadows_pier",
    "title": "Тени на пирсе",
    "subtitles": [
      {
        "time": 0.0,
        "text": "Тени выходят из тумана."
      },
      {
        "time": 2.5,
        "text": "Они двигаются слишком ровно и не оставляют следов."
      },
      {
        "time": 6.2,
        "text": "Они пришли за кораблём."
      },
      {
        "time": 8.8,
        "text": "Или за тем, кто в трюме."
      }
    ],
    "duration": 11.2,
    "audio": "audio/cutscenes/cs_shadows_pier.mp3"
  },
  "cs_third_strike": {
    "id": "cs_third_strike",
    "title": "Третий удар",
    "subtitles": [
      {
        "time": 0.0,
        "text": "Третий удар."
      },
      {
        "time": 2.5,
        "text": "Люк трескается, как лёд весной."
      },
      {
        "time": 5.0,
        "text": "Из темноты поднимается холод, а вместе с ним голос, который знает ваши имена."
      }
    ],
    "duration": 10.8,
    "audio": "audio/cutscenes/cs_third_strike.mp3"
  },
  "cs_hold_reveal": {
    "id": "cs_hold_reveal",
    "title": "Тот, кто в трюме",
    "subtitles": [
      {
        "time": 0.0,
        "text": "В оковах стоит на коленях человек, которого море не взяло и не отпустило."
      },
      {
        "time": 5.5,
        "text": "Вода стекает с его рукавов."
      },
      {
        "time": 8.0,
        "text": "Серебряные глаза поднимаются к вам."
      },
      {
        "time": 10.6,
        "text": "«Я Тьёдвар, слуга Сигурда, — говорит он. — Выпустите меня, и я скажу, кто сжёг Хладмарк»."
      }
    ],
    "duration": 17.3,
    "audio": "audio/cutscenes/cs_hold_reveal.mp3"
  },
  "cs_anchor_lost": {
    "id": "cs_anchor_lost",
    "title": "Корабль уходит",
    "subtitles": [
      {
        "time": 0.0,
        "text": "Канат лопается с глухим стоном."
      },
      {
        "time": 2.5,
        "text": "Драккар вздыхает, как зверь, которого спустили с привязи, и уходит в туман."
      },
      {
        "time": 8.1,
        "text": "Он вернётся."
      },
      {
        "time": 10.6,
        "text": "Но уже не пустым."
      }
    ],
    "duration": 13.1,
    "audio": "audio/cutscenes/cs_anchor_lost.mp3"
  },
  "cs_defeat_guards": {
    "id": "cs_defeat_guards",
    "title": "Туман смыкается",
    "subtitles": [
      {
        "time": 0.0,
        "text": "Туман смыкается над вами."
      },
      {
        "time": 2.5,
        "text": "Вас уносят так же, как уносили тех, чьи лодки возвращались пустыми."
      },
      {
        "time": 7.5,
        "text": "Вы приходите в себя на палубе, а берег уже далеко."
      }
    ],
    "duration": 11.3,
    "audio": "audio/cutscenes/cs_defeat_guards.mp3"
  },
  "cs_end_free": {
    "id": "cs_end_free",
    "title": "Оковы падают",
    "subtitles": [
      {
        "time": 0.0,
        "text": "Оковы падают на доски."
      },
      {
        "time": 2.5,
        "text": "Тьёдвар вдыхает ночь, как человек, который слишком долго был под водой."
      },
      {
        "time": 7.8,
        "text": "«Я верен слову, пока не найден ярл», — шепчет он."
      },
      {
        "time": 11.5,
        "text": "Море за вашей спиной молчит."
      },
      {
        "time": 14.0,
        "text": "Пока."
      }
    ],
    "duration": 16.5,
    "audio": "audio/cutscenes/cs_end_free.mp3"
  },
  "cs_end_interrogate": {
    "id": "cs_end_interrogate",
    "title": "Ответы",
    "subtitles": [
      {
        "time": 0.0,
        "text": "Ответы падают в тишину, как камни в воду."
      },
      {
        "time": 3.1,
        "text": "Вы узнали многое."
      },
      {
        "time": 5.6,
        "text": "Правда ли это, решать вам, а не ему."
      }
    ],
    "duration": 8.3,
    "audio": "audio/cutscenes/cs_end_interrogate.mp3"
  },
  "cs_end_kill": {
    "id": "cs_end_kill",
    "title": "Вторая смерть",
    "subtitles": [
      {
        "time": 0.0,
        "text": "Оковы вспыхивают рунами и смыкаются в последний раз."
      },
      {
        "time": 3.9,
        "text": "Тьёдвар умирает второй раз."
      },
      {
        "time": 6.4,
        "text": "Вода уходит из трюма, а холод остаётся и становится злее."
      },
      {
        "time": 10.7,
        "text": "Хладмарку это не простят."
      }
    ],
    "duration": 13.2,
    "audio": "audio/cutscenes/cs_end_kill.mp3"
  },
  "cs_end_leave": {
    "id": "cs_end_leave",
    "title": "Люк закрыт",
    "subtitles": [
      {
        "time": 0.0,
        "text": "Люк закрыт."
      },
      {
        "time": 2.5,
        "text": "Ударов больше не слышно, но все знают, что внизу кто-то ждёт."
      },
      {
        "time": 7.1,
        "text": "Ждать он умеет дольше, чем вы."
      }
    ],
    "duration": 9.6,
    "audio": "audio/cutscenes/cs_end_leave.mp3"
  }
}